# Local development only. Copy to .env and replace credentials before running.
POSTGRES_DB=aml
POSTGRES_USER=aml
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_PORT=5480
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace_with_a_strong_password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_a_strong_password
KEYCLOAK_PORT=8080
BACKEND_PORT=8000
FRONTEND_PORT=5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=aml-risk
KEYCLOAK_CLIENT_ID=aml-frontend
# The public issuer must match the `iss` claim in browser tokens. The JWKS URL
# uses Docker service DNS so the backend container can retrieve signing keys.
KEYCLOAK_ISSUER=http://localhost:8080/realms/aml-risk
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/aml-risk/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=aml-api
# Optional external AI endpoint; not bundled in Docker
AI_BASE_URL=
AI_API_KEY=local
AI_MODEL_NAME=
