# Local development only. Copy to .env and replace credentials before running.
POSTGRES_DB=aml
POSTGRES_USER=aml
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_PASSWORD=replace_with_a_strong_password
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Keycloak issuer must exactly match the `iss` claim in browser tokens.
KEYCLOAK_ISSUER=http://localhost:8080/realms/aml-risk
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/aml-risk/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=aml-api
# Optional external AI endpoint.
AI_BASE_URL=
AI_API_KEY=local
AI_MODEL_NAME=
DEV_AUTH_BYPASS=true
